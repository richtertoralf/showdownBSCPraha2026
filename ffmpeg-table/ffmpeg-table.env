# ------------------------------
# Konfiguration für jeden Stream
# /etc/ffmpeg-table.env
# MEDIAMTX_HOST: Adresse des MediaMTX-Servers
# ------------------------------
TABLE=1
MEDIAMTX_HOST=MEDIAMTX_SERVER
RTSP_PORT=8554
YOUTUBE_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_KEY=YOUTUBE_STREAM_KEY
VIDEO_DELAY=0.0
